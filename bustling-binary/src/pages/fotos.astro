---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";

const RELEASE_MADRID = "2026-06-14T13:00:00+02:00";
---

<Layout>
    <Nav />

    <main class="photos">
        <section class="photos__panel">
            <p class="kicker">Fotos</p>
            <h1>Un rincón para el día</h1>

            <p id="locked" class="text muted">
                Este apartado estará disponible a partir del
                <strong>14 de junio de 2026 · 13:00 h</strong>.
            </p>

            <section id="content" hidden>
                <p class="text">
                    Aquí podréis subir vuestras fotos y ver el álbum compartido.
                    Gracias por guardar un recuerdo de este día con nosotros.
                </p>

                <div class="actions">
                    <a class="btn" href="TU_LINK_SUBIDA" target="_blank" rel="noopener">
                        Subir fotos
                    </a>
                    <a class="btn" href="TU_LINK_ALBUM" target="_blank" rel="noopener">
                        Ver álbum
                    </a>
                </div>
            </section>
        </section>
    </main>
</Layout>

<script is:inline define:vars={{ RELEASE_MADRID }}>
    const locked = document.getElementById("locked");
    const content = document.getElementById("content");

    if (locked && content) {
        const host = location.hostname;
        const isLocal =
            host === "localhost" ||
            host === "127.0.0.1" ||
            host.startsWith("192.168.") ||
            host.startsWith("10.") ||
            host.endsWith(".local");

        if (isLocal || new Date() >= new Date(RELEASE_MADRID)) {
            locked.hidden = true;
            content.hidden = false;
        }
    }
</script>

<style>
    .photos {
        min-height: calc(100vh - 74px);
        display: grid;
        place-items: center;
        padding: clamp(56px, 10vw, 112px) 20px;
        background:
            linear-gradient(rgba(243, 238, 230, 0.84), rgba(243, 238, 230, 0.96)),
            url("/casilda-rodrigo.webp") center / cover;
        color: #25221e;
    }

    .photos__panel {
        width: min(100%, 760px);
        text-align: center;
        padding-block: clamp(30px, 6vw, 62px);
        border-top: 1px solid rgba(37, 34, 30, 0.16);
        border-bottom: 1px solid rgba(37, 34, 30, 0.16);
    }

    .kicker {
        margin: 0 0 12px;
        font-family: "Montserrat", sans-serif;
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(37, 34, 30, 0.48);
    }

    h1 {
        margin: 0;
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(3.1rem, 8vw, 6.6rem);
        font-weight: 400;
        line-height: 0.95;
        letter-spacing: 0;
    }

    .text {
        max-width: 600px;
        margin: 28px auto 0;
        font-family: "Montserrat", sans-serif;
        font-size: 0.94rem;
        font-weight: 300;
        line-height: 1.85;
        color: rgba(37, 34, 30, 0.68);
    }

    .text strong {
        font-weight: 500;
        color: #25221e;
    }

    .actions {
        display: flex;
        justify-content: center;
        gap: 26px;
        flex-wrap: wrap;
        margin-top: 34px;
    }

    .btn {
        display: inline-flex;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(37, 34, 30, 0.34);
        color: #25221e;
        font-family: "Montserrat", sans-serif;
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        text-decoration: none;
        transition: color 0.2s ease, border-color 0.2s ease;
    }

    .btn:hover {
        color: #775343;
        border-color: #775343;
    }

    @media (max-width: 720px) {
        .photos {
            min-height: calc(100svh - 88px);
            place-items: start center;
            padding-bottom: 72px;
        }

        .photos__panel {
            text-align: left;
        }

        .text {
            margin-left: 0;
            margin-right: 0;
        }

        .actions {
            justify-content: flex-start;
        }
    }
</style>
