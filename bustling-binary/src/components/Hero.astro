---
const image = "/casilda-rodrigo.webp";
---

<section class="hero" aria-labelledby="hero-title">
    <div class="hero__date" aria-label="14 de junio de 2026">
        <span>14</span>
        <span>06</span>
        <span>26</span>
    </div>

    <div class="hero__portrait">
        <img src={image} alt="Ilustración de Casilda y Rodrigo" />
    </div>

    <div class="hero__title">
        <p>Santander · 14 junio 2026</p>
        <h1 id="hero-title">Casilda<br />Rodrigo</h1>
    </div>

    <p class="hero__aside">
        Nos casamos y queremos celebrarlo con vosotros.
    </p>

    <a class="hero__cta" href="#rsvp">Confirmar asistencia</a>
</section>

<style>
    .hero {
        position: relative;
        min-height: calc(100vh - 74px);
        padding: clamp(28px, 4vw, 54px);
        display: grid;
        grid-template-columns: minmax(90px, 0.24fr) minmax(0, 1fr) minmax(220px, 0.34fr);
        grid-template-rows: minmax(0, 1fr) auto;
        gap: clamp(18px, 3vw, 42px);
        overflow: hidden;
        background: #f3eee6;
        color: #25221e;
    }

    .hero::after {
        content: "";
        position: absolute;
        inset: auto clamp(28px, 4vw, 54px) 0;
        height: 1px;
        background: rgba(37, 34, 30, 0.14);
    }

    .hero__date {
        grid-column: 1;
        grid-row: 1 / -1;
        display: grid;
        align-content: center;
        gap: clamp(10px, 2vw, 18px);
        color: rgba(37, 34, 30, 0.28);
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(3.2rem, 8vw, 8.8rem);
        font-weight: 400;
        line-height: 0.78;
        letter-spacing: 0;
    }

    .hero__portrait {
        grid-column: 2;
        grid-row: 1 / -1;
        min-height: calc(100vh - 74px - clamp(56px, 8vw, 108px));
        align-self: center;
        overflow: hidden;
        background: #efe6db;
    }

    .hero__portrait img {
        width: 100%;
        height: 100%;
        min-height: inherit;
        object-fit: cover;
        object-position: 68% center;
        display: block;
        filter: saturate(0.9) contrast(0.96) brightness(1.02);
        animation: portraitIn 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .hero__title {
        grid-column: 2 / 4;
        grid-row: 2;
        align-self: end;
        z-index: 2;
        padding-bottom: clamp(18px, 3vw, 34px);
        animation: titleIn 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
    }

    .hero__title p,
    .hero__aside,
    .hero__cta {
        font-family: "Montserrat", sans-serif;
    }

    .hero__title p {
        margin: 0 0 14px;
        color: rgba(37, 34, 30, 0.52);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    h1 {
        margin: 0;
        max-width: 840px;
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(5.2rem, 12vw, 12.4rem);
        font-weight: 400;
        line-height: 0.72;
        letter-spacing: 0;
    }

    .hero__aside {
        grid-column: 3;
        grid-row: 1;
        align-self: start;
        max-width: 220px;
        margin: 0;
        color: rgba(37, 34, 30, 0.62);
        font-size: 0.88rem;
        font-weight: 300;
        line-height: 1.8;
    }

    .hero__cta {
        grid-column: 3;
        grid-row: 1;
        align-self: end;
        justify-self: start;
        display: inline-flex;
        width: fit-content;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(37, 34, 30, 0.34);
        color: #25221e;
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-decoration: none;
        text-transform: uppercase;
        transition: color 0.2s ease, border-color 0.2s ease;
    }

    .hero__cta:hover {
        color: #775343;
        border-color: #775343;
    }

    @keyframes portraitIn {
        from {
            opacity: 0;
            transform: scale(1.03);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @keyframes titleIn {
        from {
            opacity: 0;
            transform: translateY(22px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (max-width: 980px) {
        .hero {
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: auto minmax(46vh, 1fr) auto auto auto;
            min-height: calc(100svh - 88px);
            padding: 24px 18px 50px;
            gap: 20px;
        }

        .hero__date {
            grid-column: 1;
            grid-row: 1;
            grid-template-columns: repeat(3, auto);
            justify-content: space-between;
            font-size: clamp(2.2rem, 17vw, 5.6rem);
        }

        .hero__portrait {
            grid-column: 1;
            grid-row: 2;
            min-height: 46vh;
        }

        .hero__title {
            grid-column: 1;
            grid-row: 3;
            padding-bottom: 0;
        }

        h1 {
            font-size: clamp(5rem, 24vw, 8.5rem);
        }

        .hero__aside {
            grid-column: 1;
            grid-row: 4;
            max-width: 330px;
        }

        .hero__cta {
            grid-column: 1;
            grid-row: 5;
        }
    }
</style>
