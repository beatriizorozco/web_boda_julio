<script is:inline>
    const photosLink = document.getElementById("nav-fotos");

    if (photosLink) {
        const releaseISO =
            photosLink.getAttribute("data-release") ||
            "2026-06-14T13:00:00+02:00";

        const host = location.hostname;
        const isLocal =
            host === "localhost" ||
            host === "127.0.0.1" ||
            host.startsWith("192.168.") ||
            host.startsWith("10.") ||
            host.endsWith(".local");

        if (isLocal || new Date() >= new Date(releaseISO)) {
            photosLink.hidden = false;
        }
    }

    (function () {
        const isHome = location.pathname === "/" || location.pathname === "";
        if (isHome) return;

        const ids = ["nav-ubicacion", "nav-asistencia", "nav-lista"];
        ids.forEach((id) => {
            const a = document.getElementById(id);
            if (a) a.href = "/" + a.getAttribute("href");
        });
    })();
</script>

