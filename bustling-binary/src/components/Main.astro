---
import Button from "./Button.astro";
---

<main>
    <section class="intro reveal" aria-label="Resumen de la boda">
        <p>Nos vemos en Santander</p>
        <strong>Domingo 14 de junio</strong>
        <p>La ceremonia empezará a las 13:00 h</p>
    </section>

    <section id="ubicacion" class="places" aria-label="Ubicaciones">
        <article class="place reveal">
            <figure class="place__image">
                <img src="/parroquia.webp" alt="Parroquia de la ceremonia" loading="lazy" />
            </figure>
            <div class="place__body">
                <p class="kicker">Ceremonia</p>
                <h2>Parroquia Santa María</h2>
                <p>Av. de Burgos, 12<br />Chamartín, 28036 Madrid</p>
                <Button url="https://maps.app.goo.gl/7j1RjUwrwnSJxU9m7" text="Cómo llegar" />
            </div>
        </article>

        <article class="place reveal">
            <figure class="place__image">
                <img src="/banquete.webp" alt="Lugar del banquete" loading="lazy" />
            </figure>
            <div class="place__body">
                <p class="kicker">Celebración</p>
                <h2>Finca el Gasco</h2>
                <p>Almte. Marqués de Valterra, 6<br />28250 Torrelodones, Madrid</p>
                <Button url="https://maps.app.goo.gl/wFE1dBgDovDkoN4D7" text="Cómo llegar" />
            </div>
        </article>
    </section>

    <section class="transport reveal" aria-labelledby="transport-title">
        <div>
            <p class="kicker">Transporte</p>
            <h2 id="transport-title">Autobús de la boda</h2>
        </div>

        <div class="transport__copy">
            <p>
                Tras la ceremonia habrá autobús hacia la finca. Al finalizar, la vuelta
                tendrá parada en Majadahonda y destino final Madrid.
            </p>

            <dl class="transport__facts">
                <div>
                    <dt>Salida iglesia</dt>
                    <dd>14:15 aprox.</dd>
                </div>
                <div>
                    <dt>Parking</dt>
                    <dd>Sí, en finca</dd>
                </div>
                <div>
                    <dt>Vuelta</dt>
                    <dd>22:00 / 00:00</dd>
                </div>
            </dl>
        </div>

        <img
            src="/ruta-transporte.svg"
            alt="Ruta de transporte desde la ceremonia hasta Madrid"
            class="transport__route"
            loading="lazy"
        />

        <div class="departures">
            <article>
                <p class="kicker">Salida autobús</p>
                <h3>Majadahonda</h3>
                <p>C. Las Norias, 66<br />28221 Majadahonda, Madrid</p>
                <Button url="https://maps.app.goo.gl/9ZdGU53XgV24nRJx6?g_st=iw" text="Ver ubicación" />
            </article>

            <article>
                <p class="kicker">Salida autobús</p>
                <h3>Madrid · Av. de América</h3>
                <p>Av. de América, 4<br />Salamanca, 28028 Madrid</p>
                <Button url="https://maps.app.goo.gl/CitQHob2tCGrphGJ7?g_st=iw" text="Ver ubicación" />
            </article>
        </div>
    </section>

    <section id="rsvp" class="statement reveal">
        <p class="kicker">Confirmación</p>
        <h2>¿Nos acompañas?</h2>
        <p>
            Por favor, confirma tu asistencia antes del <strong>30 de abril</strong>.
            En el formulario podrás indicar acompañantes, alergias o intolerancias.
        </p>
        <Button url="https://forms.gle/ER6xNFeWJFc3uii59" text="Confirmar asistencia" />
    </section>

    <section id="lista" class="gift reveal">
        <div>
            <p class="kicker">Lista de bodas</p>
            <h2>El mejor regalo sois vosotros</h2>
        </div>
        <div>
            <p>
                Compartir este día con vosotros es el mejor regalo. Si deseáis
                ayudarnos con el comienzo de esta nueva etapa, os dejamos nuestro
                número de cuenta.
            </p>
            <div class="iban">
                <span>IBAN</span>
                <strong class="no-autolink">ES96 0182 7402 5602 0171 5023</strong>
                <small>Concepto: “Boda Casilda y Rodrigo”</small>
            </div>
        </div>
    </section>
</main>

<script>
    const revealEls = document.querySelectorAll(".reveal");

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("revealed");
                    observer.unobserve(entry.target);
                }
            });
        },
        { threshold: 0.08, rootMargin: "0px 0px -40px 0px" }
    );

    revealEls.forEach((el) => observer.observe(el));
</script>

<style>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    main {
        background: #f3eee6;
        color: #25221e;
        padding: clamp(48px, 7vw, 96px) clamp(20px, 5vw, 78px) 92px;
    }

    .reveal {
        opacity: 0;
        transform: translateY(22px);
        transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal.revealed {
        opacity: 1;
        transform: translateY(0);
    }

    .intro,
    .places,
    .transport,
    .statement,
    .gift {
        width: min(100%, 1120px);
        margin-inline: auto;
    }

    .intro {
        margin-bottom: clamp(78px, 12vw, 150px);
        padding: clamp(28px, 4vw, 48px) 0 clamp(34px, 5vw, 62px);
        border-top: 1px solid rgba(37, 34, 30, 0.16);
        border-bottom: 1px solid rgba(37, 34, 30, 0.16);
        display: grid;
        grid-template-columns: minmax(170px, 0.42fr) minmax(0, 1fr);
        align-items: end;
        gap: clamp(24px, 6vw, 88px);
    }

    .intro p,
    .kicker,
    .note,
    .iban span,
    .iban small,
    dt {
        font-family: "Montserrat", sans-serif;
    }

    .intro p {
        margin: 0;
        max-width: 260px;
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(37, 34, 30, 0.52);
    }

    .intro strong {
        grid-column: 2;
        grid-row: 1 / span 2;
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(3.2rem, 8vw, 8.4rem);
        font-weight: 400;
        line-height: 0.9;
        letter-spacing: 0;
    }

    .places {
        margin-bottom: clamp(80px, 11vw, 140px);
    }

    .place {
        display: grid;
        grid-template-columns: minmax(220px, 0.38fr) minmax(0, 1fr);
        gap: clamp(32px, 6vw, 96px);
        align-items: center;
        padding: clamp(36px, 5vw, 64px) 0;
        border-top: 1px solid rgba(37, 34, 30, 0.14);
    }

    .place:last-child {
        border-bottom: 1px solid rgba(37, 34, 30, 0.14);
    }

    .place__image {
        margin: 0;
        aspect-ratio: 0.78;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.32);
    }

    .place__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        filter: saturate(0.86) contrast(0.97);
        transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .place:hover .place__image img {
        transform: scale(1.025);
    }

    .kicker {
        margin: 0 0 10px;
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(37, 34, 30, 0.48);
    }

    h2,
    h3 {
        margin: 0;
        font-family: "Cormorant Garamond", serif;
        font-weight: 400;
        line-height: 1.05;
        letter-spacing: 0;
        color: #25221e;
    }

    h2 {
        font-size: clamp(2.3rem, 5.4vw, 4.7rem);
    }

    h3 {
        font-size: clamp(1.7rem, 3.2vw, 2.7rem);
    }

    .place__body p:not(.kicker),
    .transport__copy p,
    .departures p:not(.kicker),
    .statement > p:not(.kicker),
    .gift p {
        font-family: "Montserrat", sans-serif;
        font-size: 0.94rem;
        font-weight: 300;
        line-height: 1.85;
        color: rgba(37, 34, 30, 0.66);
    }

    .place__body p:not(.kicker) {
        max-width: 420px;
        margin: 24px 0 28px;
    }

    .transport {
        display: grid;
        grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1fr);
        gap: clamp(28px, 5vw, 74px);
        margin-bottom: clamp(80px, 11vw, 140px);
        padding-top: clamp(34px, 5vw, 58px);
        border-top: 1px solid rgba(37, 34, 30, 0.16);
    }

    .transport__copy p {
        max-width: 600px;
        margin: 0 0 30px;
    }

    .transport__facts {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        margin: 0;
        background: rgba(37, 34, 30, 0.12);
    }

    .transport__facts div {
        background: #f3eee6;
        padding: 18px 18px 20px 0;
    }

    dt {
        margin-bottom: 8px;
        font-size: 0.66rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(37, 34, 30, 0.44);
    }

    dd {
        margin: 0;
        font-family: "Cormorant Garamond", serif;
        font-size: 1.45rem;
        color: #25221e;
    }

    .transport__route {
        grid-column: 1 / -1;
        width: min(100%, 720px);
        opacity: 0.68;
        margin-top: 10px;
    }

    .departures {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(28px, 4vw, 72px);
        padding-top: clamp(28px, 4vw, 54px);
        border-top: 1px solid rgba(37, 34, 30, 0.14);
    }

    .departures p:not(.kicker) {
        margin: 18px 0 24px;
    }

    .statement {
        max-width: 760px;
        margin-bottom: clamp(80px, 11vw, 140px);
        padding-block: clamp(30px, 5vw, 58px);
        text-align: center;
        border-top: 1px solid rgba(37, 34, 30, 0.16);
        border-bottom: 1px solid rgba(37, 34, 30, 0.16);
    }

    .statement > p:not(.kicker) {
        max-width: 610px;
        margin: 24px auto 30px;
    }

    .gift {
        display: grid;
        grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1fr);
        gap: clamp(28px, 6vw, 92px);
    }

    .gift p {
        margin: 0 0 28px;
    }

    .iban {
        display: grid;
        gap: 9px;
        padding-top: 22px;
        border-top: 1px solid rgba(37, 34, 30, 0.16);
    }

    .iban span,
    .iban small {
        font-size: 0.66rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(37, 34, 30, 0.44);
    }

    .iban strong {
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(1.45rem, 3.4vw, 2.6rem);
        font-weight: 400;
        color: #25221e;
        overflow-wrap: anywhere;
    }

    @media (max-width: 820px) {
        main {
            padding: 40px 18px 72px;
        }

        .intro,
        .place,
        .transport,
        .gift {
            grid-template-columns: 1fr;
        }

        .intro {
            gap: 12px;
        }

        .intro strong {
            grid-column: auto;
            grid-row: auto;
        }

        .place__image {
            aspect-ratio: 1.45;
        }

        .transport__facts,
        .departures {
            grid-template-columns: 1fr;
        }

        .statement {
            text-align: left;
        }

        .statement > p:not(.kicker) {
            margin-left: 0;
            margin-right: 0;
        }
    }
</style>
