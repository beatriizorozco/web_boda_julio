---
interface Props {
    url: string;
    text: string;
    variant?: "line" | "quiet";
}

const { url, text, variant = "line" } = Astro.props;
---

<a href={url} class={`btn btn--${variant}`} target="_blank" rel="noopener noreferrer">
    <span>{text}</span>
    <span class="btn__arrow" aria-hidden="true">→</span>
</a>

<style>
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        width: fit-content;
        max-width: 100%;
        padding: 0 0 8px;
        font-family: "Montserrat", sans-serif;
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.15em;
        line-height: 1.35;
        text-transform: uppercase;
        text-decoration: none;
        color: #292622;
        border-bottom: 1px solid rgba(41, 38, 34, 0.34);
        transition: color 0.2s ease, border-color 0.2s ease, gap 0.2s ease;
    }

    .btn:hover {
        color: #8a5d4b;
        border-color: #8a5d4b;
        gap: 14px;
    }

    .btn--quiet {
        color: rgba(41, 38, 34, 0.66);
        border-color: rgba(41, 38, 34, 0.2);
    }

    .btn__arrow {
        font-family: Georgia, serif;
        font-size: 0.92rem;
        line-height: 1;
    }
</style>
